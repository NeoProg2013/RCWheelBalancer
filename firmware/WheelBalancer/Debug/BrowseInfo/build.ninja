  flags = C$:\Users\NeoProg\Desktop\balancer\WheelBalancer\main.cpp -o C$:\Users\NeoProg\Desktop\balancer\WheelBalancer\Debug\Obj\ --no_cse --no_unroll --no_inline --no_code_motion --no_tbaa --no_clustering --no_scheduling --debug --endian=little --cpu=Cortex-M3 --fpu=None --dlib_config "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\arm\inc\c\DLib_Config_Normal.h" -On -I "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\arm\CMSIS\Core\Include\\" --predef_macros C$:\Users\NeoProg\Desktop\balancer\WheelBalancer\Debug\BrowseInfo\main.tmp
